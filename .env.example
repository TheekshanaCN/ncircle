APP_NAME="NCircle"
APP_ENV=local
# Must be false on the live server.
APP_DEBUG=true
# Used to build links in emails when APP_DEBUG is false.
APP_URL=http://localhost/ncircle/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Ncircle
DB_USER=root
DB_PASS=

# log = write emails to storage/logs/mail.log (local). resend = Resend API. mail = PHP mail() (needs a mail server).
MAIL_DRIVER=log
# Key from resend.com. The from address must be on a domain verified there.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@ncircle.local
MAIL_FROM_NAME="NCircle"

# Free key from developers.giphy.com. Without one, the GIF button is hidden.
GIPHY_API_KEY=
