APP_NAME="NCircle"
APP_ENV=local
# Must be false on the live server.
APP_DEBUG=true
# Used to build links in emails when APP_DEBUG is false.
APP_URL=http://localhost/ncircle/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=Ncircle
DB_USER=root
DB_PASS=

# log = write emails to storage/logs/mail.log (local). mail = PHP mail() (needs a mail server).
MAIL_DRIVER=log
MAIL_FROM=no-reply@ncircle.local

# Free key from developers.giphy.com. Without one, the GIF button is hidden.
GIPHY_API_KEY=
